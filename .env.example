# Port expose sur l'hote
PORT=3000

# Base de donnees SQLite (chemin dans le conteneur)
DATABASE_URL="file:/app/data/production.db"

# Mot de passe admin (12 caracteres minimum en production)
# Laisse vide ici : ./deploy.sh setup / deploy / update le genere sur le serveur et l'affiche
ADMIN_PASSWORD=

# Secret de signature des sessions admin (32 caracteres minimum, obligatoire en production)
# Laisse vide ici : ./deploy.sh setup / deploy / update le genere sur le serveur (openssl rand -hex 32)
NUXT_SESSION_SECRET=

# URL publique du site, encodée dans le QR code des badges SALM (facultatif)
# NUXT_PUBLIC_SITE_URL=https://lecarredesetudes.com
